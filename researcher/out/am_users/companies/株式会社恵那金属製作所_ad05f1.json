  "SNS・note（note・本文）": [
   {
    "quote": "イベントレポートvol.1 ITベンチャーから老舗製造業へ！（18年11月全体会）｜グロービス変革クラブ",
    "url": "https://note.com/globis_henkaku/n/n7707b3e62784",
    "pass": 3
